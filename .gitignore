# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
build/
dist/

# Env / secrets
.env
.env.*

# Data zones (never in git; keep outside OneDrive via ARTHA_DATA_DIR)
# Root-anchored: must not match src/artha/data/
/data/
*.parquet
*.duckdb

# Live state
*.sqlite
*.sqlite3

# Logs / run artifacts
*.log
logs/

# Internal working documents — kept local, never published.
# The plan, the per-track roadmaps, the runbook and the agent instructions
# carry sequencing, funding levels and operational detail that is nobody
# else's business. README.md and site/ are the public face; everything the
# repo needs to BUILD and RUN stays tracked.
# NOTE: these were tracked until 2026-09-08 and remain readable in commits
# before that. Untracking hides them going forward, not retroactively.
/docs/
/CLAUDE.md
/site/README.md
/.claudeignore

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node (dashboard, later phase)
node_modules/
.next/
